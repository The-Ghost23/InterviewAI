OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Supabase Dashboard > Connect > Direct or Session pooler (port 5432). Backend only.
# URL-encode special characters in the database password. Never use a VITE_ variable.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Same Project URL and public publishable key as the frontend. Never use service-role here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local development defaults (keep Ollama available on your Mac).
APP_ENV=development
AI_PROVIDER=ollama
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Production: APP_ENV=production and AI_PROVIDER=runpod.
# RUNPOD_BASE_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/openai/v1
RUNPOD_API_KEY=
RUNPOD_MODEL=Qwen/Qwen3-4B
