# Copy values into the backend host's environment settings; never commit real values.
APP_ENV=production
AI_PROVIDER=runpod
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RUNPOD_BASE_URL=
RUNPOD_API_KEY=
RUNPOD_MODEL=Qwen/Qwen3-4B
# JSON array of exact HTTPS frontend origins; no trailing slash.
CORS_ORIGINS=["https://YOUR_APP.vercel.app"]
